# Copy to .env.local for local development (never commit real values).
# In production, set these in Vercel -> Project -> Settings -> Environment Variables.

# PIN the group admin types to unlock editing (fund, tiers, goals, schedule).
# Data is stored in Upstash Redis; without Redis the deployed page is read-only
# (locally it falls back to .data/soccer.json).
SOCCER_ADMIN_PIN=

# Upstash Redis (free tier, or the Vercel Marketplace integration which sets
# KV_REST_API_URL / KV_REST_API_TOKEN instead - both are supported).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional salt for hashing visitor IPs in rate-limit keys
RATE_LIMIT_SALT=
# Optional: extra comma-separated origins allowed to call the API
ALLOWED_ORIGINS=

# Optional: Zalo Bot notifications to the group when a match is created/deleted.
# Server-side only (no REACT_APP_ prefix). Both must be set, otherwise it is skipped.
ZALO_BOT_TOKEN=
ZALO_GROUP_CHAT_ID=

# Bot replies to "@Bot David Truong help" in the group (webhook: /api/zalo-webhook).
# ZALO_WEBHOOK_SECRET: 8-256 chars, must equal the secret_token you pass to setWebhook.
ZALO_WEBHOOK_SECRET=
ZALO_BOT_NAME=Bot David Truong
# Optional: bot id from getMe (extra self-reply guard), website URL, contact text, payload-shape debug (1)
ZALO_BOT_ID=
ZALO_SITE_URL=
ZALO_CONTACT_INFO=
ZALO_WEBHOOK_DEBUG=

# Optional: Giphy API key (free at developers.giphy.com) to search GIFs inside the app.
# Without it, members can still paste a giphy.com link.
GIPHY_API_KEY=
